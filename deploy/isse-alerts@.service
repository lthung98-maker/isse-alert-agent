# Templated systemd unit. One instance serves every customer in its register; the
# instance name is only the deployment directory.
#   sudo systemctl enable --now isse-alerts@estate
# expects /srv/isse/estate/.env and customers.yaml (see deploy/) and a venv with this
# package.
[Unit]
Description=ISSE Alert Agent (%i) - Azure Monitor intake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isse
Group=isse
WorkingDirectory=/srv/isse/%i
EnvironmentFile=/srv/isse/%i/.env
ExecStart=/srv/isse/%i/venv/bin/isse-alerts watch
Restart=on-failure
RestartSec=10
# Read-only agent: it can create a ServiceDesk request and nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/isse/%i
PrivateTmp=true

[Install]
WantedBy=multi-user.target
