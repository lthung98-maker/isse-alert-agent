# ISSE Alert Agent - per-customer environment.
# One of these per customer instance (see deploy/isse-alerts@.service). The alias names
# are shared with the ISSE pipeline, so a single customer .env can serve both.

# ---- Azure: read-only, Monitoring Reader at SUBSCRIPTION scope ----
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Which alerts become requests ----
# Resource groups to file requests for (comma-separated). Match the groups the ISSE
# pipeline is scoped to so volume stays bounded. Empty = whole subscription (sandbox only).
ISSE_SANDBOX_RESOURCE_GROUP=RG-GG4-STANDALONE-TEST
# Least-severe Sev rank to raise a request for: 0=critical only ... 4=everything.
ISSE_ALERT_MIN_SEVERITY=2
# How far back each poll looks (Azure buckets to 1h/1d/7d/30d).
ISSE_ALERT_LOOKBACK_HOURS=1

# ---- Loop + dedup ----
ISSE_POLL_INTERVAL_SECONDS=30
# Relative paths resolve against the unit's WorkingDirectory (/srv/isse/<customer>).
# systemd does not expand %i inside an EnvironmentFile, so don't use it here.
ISSE_ALERT_DEDUP_DB=alerts-seen.db
ISSE_ALERT_HEARTBEAT_FILE=alerts-heartbeat
# Discover and log but file nothing. Set true for a first run against a new subscription.
ISSE_ALERT_DRY_RUN=false
# text (journal) or json (log shipper)
ISSE_LOG_FORMAT=text

# ---- ManageEngine ServiceDesk Plus (the one write path) ----
# Portal name from the SDP URL: https://sdpondemand.manageengine.com/app/<portal>/...
SDP_PORTAL=
SDP_DATA_CENTER=com
SDP_API_BASE=https://sdpondemand.manageengine.com
SDP_OAUTH_BASE=https://accounts.zoho.com
SDP_CLIENT_ID=
SDP_CLIENT_SECRET=
SDP_REFRESH_TOKEN=
SDP_QUEUE=ISSE-Standby
