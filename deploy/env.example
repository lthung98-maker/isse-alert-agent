# ISSE Alert Agent - environment.
# One agent serves every customer: which subscriptions belong to whom, and which queue
# their requests go to, is in the customer register (see customers.example.yaml).

# ---- Customers ----
# Relative paths resolve against the unit's WorkingDirectory. systemd does not expand
# %i inside an EnvironmentFile, so don't use it here.
ISSE_ALERT_CUSTOMERS_FILE=customers.yaml

# ---- Azure: one identity for every customer ----
# A service principal in OUR tenant. Each customer subscription delegates Monitoring
# Reader to it through Azure Lighthouse (deploy/lighthouse/). Read-only.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Which alerts become requests ----
# Default severity floor for customers whose register entry sets none:
# 0=critical only ... 4=everything.
ISSE_ALERT_MIN_SEVERITY=2
# How far back each poll looks (Azure buckets to 1h/1d/7d/30d).
ISSE_ALERT_LOOKBACK_HOURS=1

# ---- Loop + dedup ----
ISSE_POLL_INTERVAL_SECONDS=30
ISSE_ALERT_DEDUP_DB=alerts-seen.db
ISSE_ALERT_HEARTBEAT_FILE=alerts-heartbeat
# Discover and log but file nothing. Set true when onboarding a customer.
ISSE_ALERT_DRY_RUN=false
# text (journal) or json (log shipper)
ISSE_LOG_FORMAT=text

# ---- ManageEngine ServiceDesk Plus: one portal, a queue (group) per customer ----
# Portal name from the SDP URL: https://sdpondemand.manageengine.com/app/<portal>/...
SDP_PORTAL=
SDP_DATA_CENTER=com
SDP_API_BASE=https://sdpondemand.manageengine.com
SDP_OAUTH_BASE=https://accounts.zoho.com
SDP_CLIENT_ID=
SDP_CLIENT_SECRET=
SDP_REFRESH_TOKEN=

# ---- Single-customer mode (only when ISSE_ALERT_CUSTOMERS_FILE is unset) ----
# AZURE_SUBSCRIPTION_ID=
# ISSE_SANDBOX_RESOURCE_GROUP=RG-GG4-STANDALONE-TEST
# SDP_QUEUE=ISSE-Standby
